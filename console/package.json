{
  "name": "qtrade-console",
  "version": "1.0.0",
  "private": true,
  "description": "QTrade 多实例 IM 控制台(Electron + Vue 3)",
  "author": "QTrade",
  "main": "dist/electron/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -n mock,vite,electron \"node mock/server.mjs\" \"vite\" \"node scripts/wait-and-launch.mjs\"",
    "dev:web": "concurrently -k -n mock,vite \"node mock/server.mjs\" \"vite\"",
    "build:renderer": "vite build",
    "build:electron": "vite build --config vite.electron.config.ts",
    "build": "npm run build:renderer && npm run build:electron",
    "build:dir": "npm run build && electron-builder --dir",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.15.0",
    "eslint-plugin-vue": "^9.31.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.1.10",
    "ws": "^8.18.0"
  }
}
