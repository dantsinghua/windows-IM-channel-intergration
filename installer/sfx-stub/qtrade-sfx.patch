+   那个位置由谁双击、从哪个壳启动决定,不可预期,直接判配置错。*/
+static bool QTrade_ExpandInstallPath(const UString &src, UString &dest)
+{
+  dest.Empty();
+  if (src.IsEmpty())
+    return true;
+  WCHAR buf[MAX_PATH * 2];
+  // 长度只写一处:两处各写一遍 MAX_PATH*2,改一处忘另一处就是栈溢出
+  const DWORD kBufChars = (DWORD)Z7_ARRAY_SIZE(buf);
+  const DWORD len = ExpandEnvironmentStringsW(src.Ptr(), buf, kBufChars);
+  if (len == 0 || len > kBufChars)
+    return false;
+  dest = buf;
+  // 去掉多余的结尾分隔符,但保留 "C:\" 这种盘根形式里的那一个
+  while (dest.Len() > 3 && (dest.Back() == L'\\' || dest.Back() == L'/'))
+    dest.DeleteBack();
