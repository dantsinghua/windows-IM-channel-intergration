+/* ========================= [QTrade 补丁 a-2] =========================
+   docs/03 §2.1 要求「解压前」判目标卷可用空间,不足则不解压。
+   官方存根没有 pre-extract 钩子,但归档被 Open 之后、Extract 之前这一刻
+   就已经能读到每一项的解包大小了 —— 判据放在这里,是「真的一个字节都没写」。
+
+   门槛 = max(6 GiB, 解包总大小 x 1.1)。
+     - 6 GiB 来自 docs/03 §2.1 的硬下限;
+     - x1.1 是解压期的余量(目录项、簇对齐、以及引擎随后要落的少量文件)。
+   取不到可用空间时放行(fail-open):判据是保护,不该变成新的失败源。
+   ==================================================================== */
+
+static const UInt64 kQTradeMinFreeBytes = ((UInt64)6) << 30;  // 6 GiB = 6442450944
+
+static UInt64 QTrade_GetRequiredBytes(UInt64 unpackSize)
+{
+  const UInt64 withMargin = unpackSize + unpackSize / 10;  // x1.1
+  return (withMargin > kQTradeMinFreeBytes) ? withMargin : kQTradeMinFreeBytes;
+}
+
+/* 不用 ConvertPropVariantToUInt64:它对预料之外的 vt 会 `throw 151199`,
+   而 showProgress=false 那条路径上的 Process2() 没有 try/catch 包着。
+   这里的语义是「算不出来就当 0」,不该变成一个能把进程掀掉的异常。*/
+static UInt64 QTrade_PropToUInt64(const NWindows::NCOM::CPropVariant &prop)
+{
+  switch (prop.vt)
+  {
+    case VT_UI8: return (UInt64)prop.uhVal.QuadPart;
+    case VT_UI4: return prop.ulVal;
+    case VT_UI2: return prop.uiVal;
+    case VT_UI1: return prop.bVal;
+    default: return 0;
+  }
+}
+
+static HRESULT QTrade_GetUnpackSize(IInArchive *archive, UInt64 &total)
+{
+  total = 0;
+  UInt32 numItems = 0;
+  RINOK(archive->GetNumberOfItems(&numItems))
+  for (UInt32 i = 0; i < numItems; i++)
+  {
+    {
+      NWindows::NCOM::CPropVariant propDir;
+      RINOK(archive->GetProperty(i, kpidIsDir, &propDir))
+      if (propDir.vt == VT_BOOL && propDir.boolVal != VARIANT_FALSE)
+        continue;
+    }
+    NWindows::NCOM::CPropVariant prop;
+    RINOK(archive->GetProperty(i, kpidSize, &prop))
+    total += QTrade_PropToUInt64(prop);
+  }
+  return S_OK;
+}
+
+/* 目标目录此刻通常还不存在,GetDiskFreeSpaceEx 对不存在的路径会失败,
+   所以先用 GetVolumePathName 求出它所在卷的挂载根(这也正确处理挂载点)。*/
+static bool QTrade_GetFreeSpace(const FString &dirPath, UInt64 &freeBytes)
+{
+  freeBytes = 0;
+  WCHAR volume[MAX_PATH + 2];
+  if (!GetVolumePathNameW(fs2us(dirPath).Ptr(), volume, (DWORD)(MAX_PATH + 1)))
+    return false;
+  ULARGE_INTEGER avail, totalBytes, totalFree;
+  if (!GetDiskFreeSpaceExW(volume, &avail, &totalBytes, &totalFree))
+    return false;
+  freeBytes = (UInt64)avail.QuadPart;
+  return true;
+}
