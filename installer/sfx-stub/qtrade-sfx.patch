--- /dev/null
+++ b/CPP/7zip/Bundles/SFXSetup/QTradeStage.h
@@ -0,0 +1,192 @@
+// QTrade secure staging v2. No payload is extracted into the live install root.
+#ifndef QTRADE_STAGE_H
+#define QTRADE_STAGE_H
+
+#include <aclapi.h>
+#include <sddl.h>
+#include <shlobj.h>
+
+class CQTradeStage
+{
+  HANDLE _locks[MAX_PATH];
+  unsigned _numLocks;
+  PSECURITY_DESCRIPTOR _security;
+  PSID _system;
+  PSID _admins;
+  PSID _trustedInstaller;
+
+  bool IsTrusted(PSID sid, bool stage) const
+  {
+    return sid && (EqualSid(sid, _system) || EqualSid(sid, _admins)
+        || (!stage && EqualSid(sid, _trustedInstaller)));
+  }
+
+  bool IsSafeAcl(HANDLE handle, bool stage) const
+  {
+    PSECURITY_DESCRIPTOR descriptor = NULL;
+    PSID owner = NULL;
+    PACL acl = NULL;
+    if (GetSecurityInfo(handle, SE_FILE_OBJECT,
+        OWNER_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION,
+        &owner, NULL, &acl, NULL, &descriptor) != ERROR_SUCCESS)
+      return false;
+    bool safe = IsTrusted(owner, stage) && acl && IsValidAcl(acl);
+    SECURITY_DESCRIPTOR_CONTROL control = 0;
+    DWORD revision = 0;
+    if (stage && (!GetSecurityDescriptorControl(descriptor, &control, &revision)
+        || !(control & SE_DACL_PROTECTED)))
+      safe = false;
+    for (DWORD index = 0; safe && index < acl->AceCount; index++)
+    {
+      void *rawAce = NULL;
+      if (!GetAce(acl, index, &rawAce))
+      {
+        safe = false;
+        break;
+      }
+      const ACE_HEADER *header = (const ACE_HEADER *)rawAce;
+      // An ancestor's inherit-only ACE does not grant rights to that ancestor.
+      // A stage's inherit-only ACE can weaken extracted child files: inspect it.
+      if (!stage && (header->AceFlags & INHERIT_ONLY_ACE))
+        continue;
+      if (header->AceType == ACCESS_DENIED_ACE_TYPE)
+        continue;
+      if (header->AceType != ACCESS_ALLOWED_ACE_TYPE)
+      {
+        safe = false;
+        break;
+      }
+      const ACCESS_ALLOWED_ACE *ace = (const ACCESS_ALLOWED_ACE *)rawAce;
+      const PSID sid = (PSID)&ace->SidStart;
+      DWORD unsafeMask = WRITE_DAC | WRITE_OWNER | DELETE | FILE_DELETE_CHILD
+          | GENERIC_ALL;
+      if (stage)
+        unsafeMask |= FILE_WRITE_DATA | FILE_APPEND_DATA | FILE_WRITE_EA
+            | FILE_WRITE_ATTRIBUTES | GENERIC_WRITE;
+      if (!IsValidSid(sid) || (!IsTrusted(sid, stage) && (ace->Mask & unsafeMask)))
+        safe = false;
+    }
+    LocalFree(descriptor);
+    return safe;
+  }
+
+  bool LockDirectory(const UString &path, bool stage)
+  {
+    if (_numLocks == Z7_ARRAY_SIZE(_locks))
+      return false;
+    // Never follow a reparse point. Keep every ancestor pinned through launch.
+    // Do not share write/delete: an attacker cannot replace or reparse it later.
+    HANDLE handle = CreateFileW(path.Ptr(), READ_CONTROL | FILE_READ_ATTRIBUTES,
+        FILE_SHARE_READ, NULL, OPEN_EXISTING,
+        FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, NULL);
+    if (handle == INVALID_HANDLE_VALUE)
+      return false;
+    BY_HANDLE_FILE_INFORMATION info;
+    const bool safe = GetFileInformationByHandle(handle, &info)
+        && (info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+        && !(info.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT)
+        && IsSafeAcl(handle, stage);
+    if (!safe)
+    {
+      CloseHandle(handle);
+      return false;
+    }
+    _locks[_numLocks++] = handle;
+    return true;
+  }
+
+public:
+  CQTradeStage(): _numLocks(0), _security(NULL), _system(NULL),
+      _admins(NULL), _trustedInstaller(NULL) {}
+
+  ~CQTradeStage()
+  {
+    while (_numLocks != 0)
+      CloseHandle(_locks[--_numLocks]);
+    LocalFree(_security);
+    LocalFree(_system);
+    LocalFree(_admins);
+    LocalFree(_trustedInstaller);
+    // Keep only this run's stage for diagnostics. Never recursively delete here.
+  }
+
+  bool Create(const UString &configuredPath, UString &dest)
+  {
+    dest.Empty();
+    // This token describes a known-folder base, not a caller-controlled path.
+    if (wcscmp(configuredPath.Ptr(), L"%ProgramData%\\QTrade-Staging") != 0)
+      return false;
+    WCHAR programData[MAX_PATH];
+    if (SHGetFolderPathW(NULL, CSIDL_COMMON_APPDATA, NULL,
+        SHGFP_TYPE_CURRENT, programData) != S_OK)
+      return false;
+    UString parent(programData);
+    while (parent.Len() > 3 && parent.Back() == L'\\')
+      parent.DeleteBack();
+    // No UNC/device/relative paths, dot components, alternate streams or overflow.
+    if (!NName::IsDrivePath(parent.Ptr()) || parent.Len() <= 3
+        || parent.Len() + 1 + 14 + 1 + 36 >= MAX_PATH)
+      return false;
+    if (!ConvertStringSidToSidW(L"S-1-5-18", &_system)
+        || !ConvertStringSidToSidW(L"S-1-5-32-544", &_admins)
+        || !ConvertStringSidToSidW(
+            L"S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464",
+            &_trustedInstaller)
+        || !ConvertStringSecurityDescriptorToSecurityDescriptorW(
+            L"O:BAG:BAD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)",
+            SDDL_REVISION_1, &_security, NULL))
+      return false;
+    UString current(parent.Left(3));
+    if (!LockDirectory(current, false))
+      return false;
+    unsigned start = 3;
+    for (unsigned i = 3; i <= parent.Len(); i++)
+    {
+      const wchar_t ch = parent.Ptr()[i];
+      if (ch == L'/' || ch == L':')
+        return false;
+      if (ch != L'\\' && ch != 0)
+        continue;
+      const UString component(parent.Mid(start, i - start));
+      if (component.IsEmpty() || component.Back() == L'.' || component.Back() == L' ')
+        return false;
+      current = parent.Left(i);
+      if (!LockDirectory(current, false))
+        return false;
+      start = i + 1;
+    }
+    UString base(parent);
+    base += L"\\QTrade-Staging";
+    SECURITY_ATTRIBUTES attributes;
+    attributes.nLength = sizeof(attributes);
+    attributes.lpSecurityDescriptor = _security;
+    attributes.bInheritHandle = FALSE;
+    if (!CreateDirectoryW(base.Ptr(), &attributes) && GetLastError() != ERROR_ALREADY_EXISTS)
+      return false;
+    if (!LockDirectory(base, true))
+      return false;
+    for (unsigned attempt = 0; attempt != 8; attempt++)
+    {
+      GUID id;
+      WCHAR text[40];
+      if (CoCreateGuid(&id) != S_OK || StringFromGUID2(id, text, Z7_ARRAY_SIZE(text)) == 0)
+        return false;
+      UString candidate(base);
+      candidate += L'\\';
+      candidate += UString(text + 1).Left(36);
+      if (!CreateDirectoryW(candidate.Ptr(), &attributes))
+      {
+        if (GetLastError() == ERROR_ALREADY_EXISTS)
+          continue;
+        return false;
+      }
+      if (!LockDirectory(candidate, true))
+        return false;
+      dest = candidate;
+      return true;
+    }
+    return false;
+  }
+};
+
+#endif
